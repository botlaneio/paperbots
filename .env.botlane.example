# PaperBots (BotLane private build of Paperclip) — single-user local config.
# Copy to .env and fill in the secrets:  cp .env.botlane.example .env
# Generate secrets with:                 openssl rand -hex 32

# Leave DATABASE_URL unset to use the embedded PostgreSQL under ~/.paperclip.
# DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100

# Single operator on this machine: no login screen, loopback only.
PAPERCLIP_DEPLOYMENT_MODE=local_trusted
HOST=127.0.0.1
PAPERCLIP_PUBLIC_URL=http://localhost:3100

BETTER_AUTH_SECRET=change-me-openssl-rand-hex-32
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=change-me-openssl-rand-hex-32

# Private build: send nothing back to the upstream project.
PAPERCLIP_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
